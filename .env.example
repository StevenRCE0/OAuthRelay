# Custom URI scheme your native app handles (e.g. myapp).
OAUTH_CALLBACK_SCHEME=your-app-scheme

# Path within that scheme to redirect to (e.g. oauth/callback → myapp://oauth/callback).
OAUTH_CALLBACK_PATH=oauth/callback

# Context invites (/context). Comma-separated <TeamID>.<bundle id> list allowed
# to claim /context as a universal link; unset serves no apple-app-site-association.
APPLE_APP_IDS=ABCDE12345.com.example.app

# Optional: where /context reads its install links from. Defaults to
# keeptalking.dev/downloads.json, the list keeptalking.dev/beta renders.
# DOWNLOADS_URL=https://keeptalking.dev/downloads.json
